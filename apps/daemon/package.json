{
  "name": "@aia/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "aiad — long-running local daemon. Hosts session manager, agent runtime, channel plugin host, config and storage. See docs/arch.md §5.",
  "bin": {
    "aiad": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@aia/oxlint-config": "workspace:*",
    "@aia/tsconfig": "workspace:*"
  }
}
