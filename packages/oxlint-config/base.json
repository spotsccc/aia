{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "off"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.turbo/**", "**/coverage/**"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/test/**", "**/tests/**"],
      "rules": {
        "no-empty-function": "off"
      }
    }
  ]
}
